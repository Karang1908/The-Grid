{
  "name": "gdgoc-thegrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GDGoC chapter one: a 3D browser-based multiplayer game. Player spawns into an open world with a first/third-person camera toggle and a properly animated avatar.",
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "playcanvas": "^2.21.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "vite": "^8.2.1"
  }
}
